# Copy this file to `.env.local` for local development.
# DATABASE_URL is used by the running application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
# DIRECT_URL is used by Prisma for direct schema/migration operations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Optional: Public site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin login. The account is created/updated on the first successful login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-to-a-long-random-password"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# PAYTR API credentials
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""

# Optional PAYTR callbacks
PAYTR_OK_URL="http://localhost:3000/checkout/success"
PAYTR_FAIL_URL="http://localhost:3000/checkout/fail"
PAYTR_TEST_MODE="1"
