# Copy this file to `.env.local` for local development.
# Use your own Postgres connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Optional legacy catalog source. Product/category/brand reads use this
# database, while accounts, orders, sessions and settings stay on DATABASE_URL.
TARGET_SUPABASE_URL="postgresql://USER:PASSWORD@HOST:5432/LEGACY_DB_NAME?schema=public"

# Optional: Public site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PAYTR API credentials
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""

# Optional PAYTR callbacks
PAYTR_OK_URL="http://localhost:3000/checkout/success"
PAYTR_FAIL_URL="http://localhost:3000/checkout/fail"
PAYTR_TEST_MODE="1"
