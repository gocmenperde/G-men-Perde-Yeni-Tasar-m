{
  "name": "@workspace/store",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Göçmen Kırtasiye",
    "email": "nurse.emin016@gmail.com"
  },
  "scripts": {
    "dev": "next dev -p $PORT",
    "build": "node scripts/build-production.mjs",
    "start": "next start -p $PORT",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "sync:prices": "node scripts/bkm-sync.js",
    "sync:dry-run": "node scripts/bkm-sync.js --dry-run",
    "sync:new": "node scripts/bkm-sync.js --new-only",
    "fix:prices": "node --experimental-vm-modules scripts/fix-low-prices.mjs",
    "fix:prices-dry": "node --experimental-vm-modules scripts/fix-low-prices.mjs --dry-run"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@hookform/resolvers": "^3.10.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.469.0",
    "next": "15.5.25",
    "next-auth": "4.24.15",
    "next-themes": "^0.4.4",
    "nodemailer": "^6.10.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.2",
    "recharts": "^2.15.3",
    "slugify": "^1.6.6",
    "stripe": "^17.5.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
